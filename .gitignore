# .gitignore for NGOHUB Project

# Confidential & Competition Files (Strictly Private - DO NOT PUSH)
ملفات_المسابقة_والتوثيق_الخاصة/
مبادرة المشاريع الخضراء الذكية/
تطبيق_الهاتف/android/
تطبيق_الهاتف/apk/
*.docx
*.pptx
*.idsig

# Allow public web assets, simulator, and APK
!assets/apk/NGOHUB.apk
!NGOHUB.apk

# System & Cache
__pycache__/
*.pyc
*.pyo
.system_generated/
*.log
.DS_Store
tests/

# Internal Developer Documentation & Audit Reports
UPDATE.md
AUDIT_REPORT.md
docs/audit_reports/
docs/specs/
docs/guides/
docs/ngohub_digital_access_portal.html
docs/ngohub_digital_access_portal.pdf
ngohub_digital_access_portal.html
ngohub_digital_access_portal.pdf
ngohub_digital_access_portal.png

# Duplicate mobile source
تطبيق_الهاتف/

# Scratch & Large Archives
*.zip
audit_script.py
generate_audit_pdf.py
generate_preview_png.py
بوستات فيس مع الشراكة بروتك/


